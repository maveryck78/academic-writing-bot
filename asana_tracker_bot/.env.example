# Asana Personal Access Token: Asana > Profile photo > Settings > Apps > Developer apps > New access token
ASANA_TOKEN=
# Optional; defaults to your first workspace
ASANA_WORKSPACE_GID=
# Create a bot with @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_TELEGRAM_USER_IDS=
# Daily digest time (24h HH:MM) and timezone
DIGEST_TIME=08:30
TZ_NAME=UTC
